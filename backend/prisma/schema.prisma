// Prisma schema untuk Mesitra
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PENYEWA
  PEMILIK
  ADMIN
}

enum AdminRole {
  SUPERADMIN
  STAFF
}

/**
 * Status verifikasi KYC yang dipakai Portal Verifikasi Admin.
 * - MENUNGGU          : pengajuan baru dikirim, belum ditinjau admin
 * - PERLU_PERBAIKAN  : admin meminta pengaju memperbaiki step tertentu
 * - DISETUJUI        : akun aktif, penyewa boleh masuk ke /beranda-sewa
 * - DITOLAK          : pengajuan ditolak permanen
 */
enum VerificationStatus {
  MENUNGGU
  PERLU_PERBAIKAN
  DISETUJUI
  DITOLAK
}

/**
 * Status siklus hidup alat yang disewakan.
 * - TERSEDIA   : alat siap disewa dan tampil di katalog penyewa
 * - DISEWA     : sedang disewa penyewa lain (disembunyikan dari katalog)
 * - MAINTENANCE: sedang diservis / rawat (disembunyikan dari katalog)
 */
enum EquipmentStatus {
  TERSEDIA
  DISEWA
  MAINTENANCE
  INSPEKSI
  NONAKTIF
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role
  fullName String
  phone    String

  // Kode pengajuan unik (mis. VR-2041) untuk tracking di portal admin.
  submissionCode     String?            @unique
  // Status alur verifikasi KYC yang ditangani admin.
  verificationStatus VerificationStatus @default(MENUNGGU)
  // Seluruh data form registrasi Step 1-5 (termasuk metadata file foto).
  kycData            Json?
  // Array nomor step yang diminta diperbaiki admin (mis. [1, 3]).
  revisionSteps      Json?
  // Catatan admin: alasan perbaikan atau penolakan.
  adminNote          String?            @db.Text

  // Saldo dompet digital / escrow payout
  walletBalance Int @default(0)

  // Kontrol Suspensi Akun oleh Admin
  isSuspended     Boolean   @default(false)
  suspendedReason String?   @db.Text
  suspendedAt     DateTime?
  suspendedById   String?

  // Audit Trail Verifikasi KYC
  verifiedAt   DateTime?
  verifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipments Equipment[]
  orders     Order[]
  reviews    Review[]

  renterConversations Conversation[] @relation("RenterConversations")
  ownerConversations  Conversation[] @relation("OwnerConversations")
  sentMessages        Message[]      @relation("SentMessages")

  withdrawalAccounts WithdrawalAccount[]
  walletTransactions WalletTransaction[]

  withdrawalRequests WithdrawalRequest[]
  disputeTickets     DisputeTicket[]     @relation("RenterDisputeTickets")
  adminAuditLogs     AdminAuditLog[]     @relation("AdminActionLogs")

  tenantProfile TenantProfile?
  notifications Notification[]
}

model Equipment {
  id                    String          @id @default(uuid())
  ownerId               String
  name                  String
  category              String
  description           String          @db.Text
  pricePerDay           Int
  deposit               Int
  powerWatt             Int
  weightKg              Float           @default(10)
  dimensions            String          @default("40 × 30 × 30 cm")
  // Durasi minimal hari penyewaan
  minRentDays           Int             @default(1)
  // Jeda rawat yang harus disisihkan setelah alat kembali dari penyewa.
  maintenanceBufferDays Int             @default(1)
  location              String          @default("Jakarta Selatan")
  // Jarak (km) dari titik acuan penyewa — sementara dipakai untuk badge "Terdekat".
  distance              Float           @default(2.5)
  status                EquipmentStatus @default(TERSEDIA)
  // Array URL foto alat (JSON array of string).
  images                Json?
  // Daftar kelengkapan / aksesoris (JSON array of string, mis. ["Kabel", "Nozzle"])
  accessories           Json?
  // Metode pengiriman yang didukung (JSON array of string, mis. ["PICKUP", "COURIER"])
  deliveryMethods       Json?
  // Ongkos kirim jika menggunakan kurir toko (default 45.000)
  deliveryFee           Int             @default(45000)
  // Kondisi alat (mis. "Prima", "Terawat", "Sangat Baik")
  condition             String          @default("Prima")
  stock                 Int             @default(1)
  // Soft delete flag untuk menjaga keutuhan riwayat Order
  isDeleted             Boolean         @default(false)

  // Kontrol Takedown Admin
  isTakedownByAdmin Boolean   @default(false)
  takedownReason    String?   @db.Text
  takedownAt        DateTime?
  moderatedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  orders  Order[]
  reviews Review[]

  @@index([ownerId])
  @@index([status])
  @@index([isDeleted])
  @@index([isTakedownByAdmin])
}

/**
 * Status siklus hidup pesanan sewa.
 * - MENUNGGU_PEMBAYARAN : pesanan dibuat di Step 2, menunggu pembayaran di Step 3
 * - MENUNGGU_KONFIRMASI : pembayaran escrow diterima, menunggu pemilik setuju
 * - DIKIRIM             : pemilik telah menyetujui dan alat sedang dikirim
 * - SEWA_AKTIF          : alat sudah diterima penyewa (BAST awal OK)
 * - INSPEKSI            : penyewa sudah submit BAST akhir, menunggu inspeksi pemilik
 * - SELESAI             : sewa selesai, deposit dikembalikan
 * - DISPUTE             : ada klaim / sengketa
 * - DITOLAK             : pesanan ditolak oleh pemilik
 * - DIBATALKAN          : pesanan dibatalkan oleh penyewa
 */
enum OrderStatus {
  MENUNGGU_PEMBAYARAN
  MENUNGGU_KONFIRMASI
  DIKIRIM
  SEWA_AKTIF
  INSPEKSI
  SELESAI
  DISPUTE
  DITOLAK
  DIBATALKAN
}

model Order {
  id            String @id @default(uuid())
  invoiceNumber String @unique
  userId        String
  equipmentId   String

  startDate      DateTime
  endDate        DateTime
  rentalDays     Int
  deliveryMethod String // 'PICKUP' | 'COURIER'

  rentalCost    Int
  shippingCost  Int
  depositAmount Int
  lateFee       Int @default(0)
  damageFee     Int @default(0)
  totalPaid     Int

  status OrderStatus @default(MENUNGGU_PEMBAYARAN)

  // ── Checkout metadata ─────────────────────────────────────────────────────
  // Array layanan tambahan: [{id, label, price}]
  addons           Json?
  addonsCost       Int       @default(0)
  // Kode promo yang dipakai penyewa
  promoCode        String?
  discountAmount   Int       @default(0)
  // Catatan bebas untuk pemilik alat
  renterNotes      String?   @db.Text
  // Waktu penyewa menyetujui kontrak sewa digital di Step 2
  contractAgreedAt DateTime?

  // ── Payment metadata ─────────────────────────────────────────────────────
  // 'QRIS' | 'VA_BCA' | 'EWALLET' | 'CARD'
  paymentMethod   String?
  paidAt          DateTime?
  // Batas waktu pembayaran (24 jam dari createdAt)
  paymentDeadline DateTime?

  // Data serah terima awal (BAST Awal: foto awal alat, checklist, catatan)
  initialBast Json?

  // Data pengembalian Step 1-4 (jadwal, checklist, foto, tanda tangan, BAST Akhir).
  returnData            Json?
  disputeNote           String? @db.Text
  disputeReason         String? @db.Text
  // Foto bukti kerusakan dari pemilik saat mengajukan klaim / menolak BAST
  ownerInspectionPhotos Json?

  // Data putusan mediasi admin Mesitra
  finalDamageFee      Int?
  adminResolutionNote String?   @db.Text
  resolvedAt          DateTime?
  isResolvedByAdmin   Boolean   @default(false)

  // Pencatatan Resmi Ledger Potongan Platform 5%
  platformFeeRate Float @default(0.05)
  platformFee     Int   @default(0)
  netOwnerPayout  Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  equipment     Equipment      @relation(fields: [equipmentId], references: [id])
  review        Review?
  disputeTicket DisputeTicket?

  @@index([userId])
  @@index([equipmentId])
  @@index([status])
}

model Review {
  id          String    @id @default(uuid())
  orderId     String    @unique
  equipmentId String
  userId      String
  rating      Int
  comment     String    @db.Text
  ownerReply  String?   @db.Text
  repliedAt   DateTime?

  // Moderasi Konten Ulasan
  isDeleted      Boolean   @default(false)
  isFlagged      Boolean   @default(false)
  moderatedAt    DateTime?
  moderatedById  String?
  moderationNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([userId])
  @@index([isDeleted])
}

model Conversation {
  id            String   @id @default(uuid())
  renterId      String
  ownerId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  renter   User      @relation("RenterConversations", fields: [renterId], references: [id], onDelete: Cascade)
  owner    User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([renterId, ownerId])
  @@index([renterId])
  @@index([ownerId])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  contextType    String? // 'EQUIPMENT' | 'ORDER'
  contextData    Json? // snapshot data alat / invoice pesanan
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model WithdrawalAccount {
  id            String   @id @default(uuid())
  userId        String
  bankName      String // 'BCA', 'Mandiri', 'BRI', 'BNI', 'GoPay', 'OVO', 'DANA', dll
  accountNumber String
  accountHolder String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WalletTransactionType {
  TOPUP
  WITHDRAW
  SEWA_PAYMENT
  DEPOSIT_HOLD
  DEPOSIT_REFUND
  REFUND
}

enum WalletTransactionStatus {
  BERHASIL
  MENUNGGU
  GAGAL
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  userId        String
  type          WalletTransactionType
  amount        Int
  description   String
  status        WalletTransactionStatus @default(BERHASIL)
  reference     String?
  paymentMethod String?
  createdAt     DateTime                @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/**
 * Profil toko pemilik alat (1:1 dengan User).
 * Menyimpan informasi toko, jam operasional, status KYC per-dokumen,
 * dan preferensi notifikasi. Dibuat secara additive — kycData JSON
 * pada User tetap dipertahankan untuk kompatibilitas mundur.
 * joinYear: tidak disimpan di sini; gunakan User.createdAt year saat membaca.
 */
enum NotificationType {
  ORDER_NEW
  RETURN_REMINDER
  INSPECTION
  DISPUTE
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  title       String
  message     String           @db.Text
  type        NotificationType
  isRead      Boolean          @default(false)
  referenceId String? // orderId terkait, untuk deep-link ke OrderDetail
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model TenantProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Informasi Toko
  storeName        String?
  storeDescription String? @db.Text
  storeCategory    String?
  whatsappNumber   String?
  address          String?
  city             String?
  serviceRadius    Int? // radius layanan dalam km

  // Jam Operasional (JSON): { weekdays: { open: "08:00", close: "17:00" }, saturday: { open: "09:00", close: "15:00" }, sunday: null }
  operatingHours Json?

  // Status KYC per dokumen (denormalisasi dari kycData untuk query efisien)
  ktpVerified         Boolean @default(false)
  nibVerified         Boolean @default(false)
  bankAccountVerified Boolean @default(false)
  npwpVerified        Boolean @default(false)

  // Preferensi Notifikasi
  notifPesananBaru       Boolean @default(true)
  notifPengembalianAlat  Boolean @default(true)
  notifInspeksiDeposit   Boolean @default(false)
  notifRingkasanMingguan Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WithdrawalStatus {
  MENUNGGU
  DIPROSES
  SELESAI
  DITOLAK
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_OWNER_WIN
  RESOLVED_RENTER_WIN
  RESOLVED_SPLIT
  ESCALATED_LEGAL
}

model WithdrawalRequest {
  id               String           @id @default(uuid())
  withdrawalCode   String           @unique
  userId           String
  amount           Int
  transferFee      Int              @default(0)
  netAmount        Int
  bankName         String
  accountNumber    String
  accountHolder    String
  status           WithdrawalStatus @default(MENUNGGU)
  bankReference    String?
  transferProofUrl String?
  processedAt      DateTime?
  processedById    String?
  adminNotes       String?          @db.Text
  rejectionReason  String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model DisputeTicket {
  id                  String        @id @default(uuid())
  ticketNumber        String        @unique
  orderId             String        @unique
  renterId            String
  ownerId             String
  claimAmount         Int
  disputeReason       String        @db.Text
  ownerPhotos         Json?
  renterDefenseNote   String?       @db.Text
  renterCounterPhotos Json?
  // Metadata pihak yang menginisiasi sengketa: 'PEMILIK' | 'PENYEWA' | 'ADMIN'
  initiatedById       String?
  initiatedByRole     String?
  defendedAt          DateTime?
  status              DisputeStatus @default(OPEN)
  finalDamageFee      Int?
  refundToRenter      Int?
  payoutToOwner       Int?
  adminArbitrageNote  String?       @db.Text
  arbitratedAt        DateTime?
  arbitratedById      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  renter User  @relation("RenterDisputeTickets", fields: [renterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([ownerId])
  @@index([renterId])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActionLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
}

model AdminUser {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            AdminRole @default(STAFF)
  securityPinHash String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?

  @@index([email])
  @@index([role])
  @@index([isActive])
}
